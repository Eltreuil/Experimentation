{
  "name": "OpenBIM Studio",
  "short_name": "OpenBIM",
  "description": "Modeleur BIM open source inspiré de Revit",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#eef1f4",
  "theme_color": "#1f2a37",
  "lang": "fr",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "file_handlers": [{ "action": "./", "accept": { "application/json": [".obim", ".json"] } }]
}
